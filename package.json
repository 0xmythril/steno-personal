{
  "name": "steno-personal",
  "version": "0.1.0",
  "private": true,
  "description": "Your own Telegram and WhatsApp chats, archived read-only into one SQLite file on a machine you control, readable by your agents over MCP.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xmythril/steno-personal.git"
  },
  "homepage": "https://github.com/0xmythril/steno-personal#readme",
  "bugs": {
    "url": "https://github.com/0xmythril/steno-personal/issues"
  },
  "keywords": [
    "telegram",
    "whatsapp",
    "chat-archive",
    "sqlite",
    "mcp",
    "self-hosted",
    "read-only",
    "agents"
  ],
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx scripts/boot.ts && next dev",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "worker": "tsx worker/index.ts",
    "boot": "tsx scripts/boot.ts",
    "mint-key": "tsx scripts/mint-key.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@mtcute/node": "^0.32.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "mcp-handler": "^2.1.1",
    "next": "16.3.4",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tsx": "^4.23.13",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
