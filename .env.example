# Where the SQLite file, media, and WhatsApp auth state live. Docker sets /data.
DATA_DIR=./data
PORT=3000
# Optional. Encrypts revealable access keys and channel secrets at rest.
# Leave unset to have one generated into $DATA_DIR/secret.key on first boot.
SECRET_KEY=
LOG_LEVEL=info

# Optional. Only needed until the project ships its own registered pair, or if
# you would rather use your own application from https://my.telegram.org.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Enrichment (image OCR, voice-note transcription). Off until you save an
# OpenRouter key in Settings; these only bound it once it is on.
ANALYSIS_DAILY_LIMIT=500
ANALYSIS_BACKFILL_BATCH=20

# Which processes scripts/start.mjs launches. Anything but the literal string
# `false` means on. Run the web app and the worker on separate hosts by
# setting one of these to false on each.
RUN_WEB=
RUN_WORKER=

# Optional. Where the once-a-day anonymous usage ping is posted. LEAVE THIS
# EMPTY and nothing is ever built or sent, whatever the Settings toggle says.
# Set it and the ping runs until the user turns it off in Settings. It carries
# a random id minted locally, the version, which channels are live, counts of
# chats, messages, people and keys, and the enrichment toggles — never a
# message, a name, a number, a title, a query or a key. See PRIVACY.md.
STENO_TELEMETRY_URL=

# Host-operator operations, each performed once per value at boot and then
# remembered in $DATA_DIR/boot-ops.json, so a variable left set does nothing
# on the next restart. Leave both empty in normal use.
#   STENO_MINT_KEY=<label>  mints an access key with that label and prints it
#                           in the boot log — for when every key is lost.
#   STENO_RESET=<any word>  empties DATA_DIR: database, media, WhatsApp auth
#                           state. The next visit starts setup from scratch.
STENO_MINT_KEY=
STENO_RESET=
