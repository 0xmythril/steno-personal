# Where the SQLite file, media, and WhatsApp auth state live. Docker sets /data.
DATA_DIR=./data
PORT=3000
# Optional. Encrypts revealable access keys and channel secrets at rest.
# Leave unset to have one generated into $DATA_DIR/secret.key on first boot.
SECRET_KEY=
LOG_LEVEL=info

# Optional. Only needed until the project ships its own registered pair, or if
# you would rather use your own application from https://my.telegram.org.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Enrichment (image OCR, voice-note transcription). Off until you save an
# OpenRouter key in Settings; these only bound it once it is on.
ANALYSIS_DAILY_LIMIT=500
ANALYSIS_BACKFILL_BATCH=20

# Which processes scripts/start.mjs launches. Anything but the literal string
# `false` means on. Run the web app and the worker on separate hosts by
# setting one of these to false on each.
RUN_WEB=
RUN_WORKER=
